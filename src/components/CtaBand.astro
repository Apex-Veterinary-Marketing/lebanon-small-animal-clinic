---
// Full-width call-to-action band (Lebanon design pass: deep-teal band with the
// raspberry booking button, same buttons as the approved homepage).
// The button defaults to the site's booking action (site.bookingUrl /
// bookingLabel) — pass ctaText/ctaHref only when a page needs another target.
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";

export interface Props {
  heading: string;
  text?: string;
  ctaText?: string;
  ctaHref?: string;
}
const site = await getSiteInfo();
const { heading, text, ctaText = site.bookingLabel || "Book Now", ctaHref = site.bookingUrl || "/contact-us" } = Astro.props;
const external = /^https?:\/\//.test(ctaHref);
---

<section class="cta-band">
  <div class="cta-band__inner">
    <div class="cta-band__copy">
      <h2 class="cta-band__heading">{heading}</h2>
      {text && <p class="cta-band__text">{text}</p>}
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--cta btn--lg" href={ctaHref} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{ctaText}</a>
      {site.phoneNumber && <a class="btn btn--ghost-light btn--lg" href={phoneHref(site)}>Call {site.phoneNumber}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band { background: var(--main-dark); color: var(--white); }
  .cta-band__inner { max-width: var(--container-max); margin-inline: auto; padding: var(--space-2xl) var(--space-md); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-lg); }
  .cta-band__heading { margin: 0 0 var(--space-xs); color: inherit; font-size: var(--font-size-3xl); }
  .cta-band__text { margin: 0; opacity: 0.9; max-width: 36rem; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  @media (max-width: 767px) {
    .cta-band__heading { font-size: var(--font-size-2xl); }
    .cta-band__actions, .cta-band__actions .btn { width: 100%; }
  }
</style>
