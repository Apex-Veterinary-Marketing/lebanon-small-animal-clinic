---
// Generalized from the real V2 Webflow export's footer.html: accordion
// columns (native <details>/<summary>, zero JS) that collapse only on
// mobile.
//
// Restructured 2026-09-17 back toward the real export's actual 5-column
// layout (About us / Services / Dental Care / Surgery / Resources) —
// previously Skeleton had generalized Dental/Surgery away into one
// dynamic "Services" column (see git history); direct instruction to
// restore the dedicated per-category columns. Dental/Surgery are matched
// by category id ("dental"/"surgery" — Skeleton's own example category
// slugs, the same ones services-categories/[slug].astro already routes
// on) rather than hardcoded names, and each column disappears gracefully
// if a client doesn't have that category (getServiceCategoryBySlug
// returns undefined) — same "only render what's configured" pattern as
// ReputationWidget's review links. "Services" (general) lists every
// service NOT in Dental or Surgery, so a client's Wellness Care (or any
// future third category) still surfaces somewhere.
//
// About Us column also absorbed what used to be its own "Follow Us"
// column — logo, ~160-char footerAbout blurb, the existing About Us
// links, then the social icons — direct instruction, freeing up the
// column slot the Dental/Surgery split needed.
import { getSiteInfo } from "../lib/data/site";
import { getServiceCategoryBySlug } from "../lib/data/serviceCategories";
import { getAllServices, getServicesByCategory } from "../lib/data/services";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import { SOCIAL_ICON_CLASSES, SOCIAL_LABELS } from "../lib/icons/social";
import { phoneHref } from "../lib/utils/phone";
import awardBadge from "../assets/site/award-businessrate-crystal.png";
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { byCategoryOrder } from "../data/service-category-order";
import { BLOG_BASE } from "../lib/data/blog";
import ReviewsBand from "./ReviewsBand.astro";

const site = await getSiteInfo();
const socialLinks = await getAllSocialLinks();
const year = new Date().getFullYear();

// Lebanon: one Pet Care column (the old site lists all care pages together), no
// separate Dental/Surgery columns — each would hold a single link.
const DEDICATED_CATEGORY_IDS: string[] = [];
const [dentalCategory, surgeryCategory] = await Promise.all(
  DEDICATED_CATEGORY_IDS.map((id) => getServiceCategoryBySlug(id))
);
const [dentalServices, surgeryServices, allServices] = await Promise.all([
  dentalCategory ? getServicesByCategory("dental") : Promise.resolve([]),
  surgeryCategory ? getServicesByCategory("surgery") : Promise.resolve([]),
  getAllServices(),
]);
const serviceCategories = (await getAllServiceCategories()).sort(byCategoryOrder);
const generalServices = allServices.filter(
  (service) => !service.data.serviceCategory.some((ref) => DEDICATED_CATEGORY_IDS.includes(ref.id))
);
---

<footer class="footer">
  {/* Fixed-position floating pill (desktop only) — not in-flow footer content, see ReviewsBand.astro. */}
  <ReviewsBand />

  <div class="footer__grid">
    <details class="footer__column footer__column--about" open>
      <summary class="footer__column-title">About Us</summary>
      <div class="footer__about">
        {site.logoWhite || site.logoColor ? (
          <img class="footer__logo" src={site.logoWhite || site.logoColor} alt={site.practiceName} />
        ) : (
          <span class="footer__logo-text">{site.practiceName}</span>
        )}
        {site.footerAbout && <p class="footer__about-text">{site.footerAbout}</p>}
        <img class="footer__award" src={awardBadge.src} width={awardBadge.width} height={awardBadge.height} alt="Best of 2026 BusinessRate award winner" loading="lazy" decoding="async" />
        <ul class="footer__link-list">
          <li><a href="/why-choose-us">Why Choose Us?</a></li>
          <li><a href="/meet-the-team">Our Care Team</a></li>
          <li><a href="/careers">Careers</a></li>
          <li><a href="/testimonials">Testimonials</a></li>
          <li><a href="/community-outreach">Community Outreach</a></li>
          <li><button type="button" class="footer__link-button" data-modal-target="reputation-widget">How'd We Do?</button></li>
        </ul>
        <div class="footer__social-icons">
          {socialLinks.map((social) => (
            <a
              class="footer__social-icon"
              href={social.data.link}
              aria-label={SOCIAL_LABELS[social.data.icon]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class={SOCIAL_ICON_CLASSES[social.data.icon]} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </details>

    <details class="footer__column" open>
      <summary class="footer__column-title">Pet Care</summary>
      <ul class="footer__link-list">
        {serviceCategories.map((category) => (
          <li><a href={`/services-categories/${category.id}`}>{category.data.name}</a></li>
        ))}
        <li><a href="/services"><strong>All Pet Care</strong></a></li>
      </ul>
    </details>

    {dentalCategory && (
      <details class="footer__column" open>
        <summary class="footer__column-title">{dentalCategory.data.name}</summary>
        <ul class="footer__link-list">
          {dentalServices.map((service) => (
            <li><a href={`/services/${service.id}`}>{service.data.customName || service.data.name}</a></li>
          ))}
        </ul>
      </details>
    )}

    {surgeryCategory && (
      <details class="footer__column" open>
        <summary class="footer__column-title">{surgeryCategory.data.name}</summary>
        <ul class="footer__link-list">
          {surgeryServices.map((service) => (
            <li><a href={`/services/${service.id}`}>{service.data.customName || service.data.name}</a></li>
          ))}
        </ul>
      </details>
    )}

    <details class="footer__column" open>
      <summary class="footer__column-title">Patient Resources</summary>
      <ul class="footer__link-list">
        <li><a href="/what-to-expect">What to Expect</a></li>
        <li><a href="/pets-we-care-for">Pets We Care For</a></li>
        <li><a href="/wellness-plans">Wellness Plans</a></li>
        <li><a href="/payment-options">Payment Options</a></li>
        <li><a href="/urgent-care-and-house-calls">Urgent Care &amp; House Calls</a></li>
        <li><a href="/faq">FAQs</a></li>
        <li><a href="/online-forms">New Patient Forms</a></li>
        <li><a href={BLOG_BASE}>Blog</a></li>
        <li><a href="https://lebanonsmallanimalclinic.covetruspharmacy.com" target="_blank" rel="noopener noreferrer">Pharmacy</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/ada-policy">ADA Policy</a></li>
      </ul>
    </details>
    <div class="footer__column footer__column--visit">
      <p class="footer__column-title">Visit Us</p>
      <div class="footer__visit">
        {site.address && (
          <a class="footer__visit-line" href={site.addressLink || "/contact-us"} target="_blank" rel="noopener noreferrer">
            {site.address}<br />{site.addressLine2}
          </a>
        )}
        {site.phoneNumber && <a class="footer__visit-line footer__visit-phone" href={phoneHref(site)}>{site.phoneNumber}</a>}
        {site.hours && <div class="footer__hours" set:html={site.hours} />}
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <p class="footer__copyright">&copy; {year} {site.practiceName}. All rights reserved.</p>
    <a class="footer__signature" href="https://veterinarymarketing.com/" target="_blank" rel="noopener noreferrer">
      Made with &hearts; by Veterinary Marketing
    </a>
  </div>
</footer>

<style>
  /* Lebanon: deep-teal footer, two-tone logo (no white panel), no column dividers,
     no link underlines — hover is an eased opacity change (agency QA rules). */
  .footer { background: var(--footer-bg); color: var(--footer-text); padding-block-start: var(--space-2xl); }
  .footer__grid { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-md); display: grid; grid-template-columns: 1.3fr 1.3fr 1fr 1fr; gap: var(--space-xl); }
  .footer__column { padding-block-end: var(--space-sm); }
  .footer__column-title { margin: 0; font-family: var(--font-heading); font-weight: 600; font-size: var(--font-size-md); color: var(--footer-heading); cursor: default; padding-block: var(--space-xs); }
  .footer__link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); margin-block-start: var(--space-sm); }
  .footer__link-list a, .footer__link-button, .footer__visit-line { color: inherit; text-decoration: none; background: none; border: 0; font: inherit; padding: 0; text-align: start; cursor: pointer; opacity: 0.85; transition: opacity var(--motion-duration-base) var(--motion-ease); }
  .footer__link-list a:hover, .footer__link-button:hover, .footer__visit-line:hover { opacity: 1; }

  .footer__about { display: flex; flex-direction: column; gap: var(--space-md); margin-block-start: var(--space-sm); }
  .footer__logo { width: 100%; max-width: 15rem; height: auto; object-fit: contain; }
  .footer__logo-text { font-weight: 700; font-size: var(--font-size-lg); color: var(--footer-heading); }
  .footer__about-text { margin: 0; font-size: var(--font-size-sm); opacity: 0.85; line-height: 1.6; max-width: 22rem; }
  .footer__about .footer__link-list { margin-block-start: 0; }
  .footer__award { align-self: flex-start; width: auto; height: 7rem; }

  .footer__visit { display: flex; flex-direction: column; gap: var(--space-sm); margin-block-start: var(--space-sm); font-size: var(--font-size-sm); }
  .footer__visit-phone { font-weight: 700; opacity: 1; font-size: var(--font-size-md); }
  .footer__hours { opacity: 0.85; }
  .footer__hours :global(p) { margin: 0; }

  .footer__social-icons { display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .footer__social-icon { color: inherit; display: inline-flex; font-size: var(--font-size-lg); opacity: 0.85; text-decoration: none; transition: opacity var(--motion-duration-base) var(--motion-ease); }
  .footer__social-icon:hover { opacity: 1; }

  .footer__bottom { max-width: var(--container-max); margin-inline: auto; padding: var(--space-lg) var(--space-md); margin-block-start: var(--space-xl); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm); font-size: var(--font-size-sm); opacity: 0.85; }
  .footer__signature { color: inherit; text-decoration: none; transition: opacity var(--motion-duration-base) var(--motion-ease); }
  .footer__signature:hover { opacity: 0.7; }

  @media (min-width: 900px) {
    .footer__column summary { pointer-events: none; list-style: none; }
    .footer__column summary::marker,
    .footer__column summary::-webkit-details-marker { display: none; content: ""; }
  }

  @media (max-width: 1100px) {
    .footer__grid { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  }
  @media (max-width: 899px) {
    .footer__grid { grid-template-columns: 1fr; gap: var(--space-md); }
    .footer__column-title { cursor: pointer; }
  }
</style>
