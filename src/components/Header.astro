---
// Sitewide fixed header. Generalized from the real V2 Webflow export's
// header.html (utility bar + primary nav with a Services flyout) — see
// Skeleton-Build-Spec.md §6. The Services dropdown is fully dynamic
// (one flyout per live service category) rather than hardcoding category
// names the way the V2 source does, since Skeleton has no fixed category
// list.
//
// Scroll-state color system (2026-09-08, real visual ref: ref1.jpg):
// always sticky (position: fixed); default state is transparent
// background + white text/icons/logo, meant to sit over a hero/banner's
// dark overlay (see Hero.astro / PageHeaderBanner.astro, both padded to
// render full-bleed behind this header rather than pushed below it);
// past a small scroll threshold, .header gets is-scrolled (JS below),
// which flips to a white background + dark text/icons/logo. The "Book
// Now" CTA button stays solid-colored in both states — it's a button, not
// a nav link. The mobile slide-out menu panel is exempted from the
// swap (forced dark-on-white always, see the max-width:900px block) since
// it's a full solid panel, not part of the transparent top bar.
//
// Logo: site.logoWhite/logoColor (src/data/site.ts) stack and crossfade
// with the same scroll state, the classic two-image-variant technique.
// Only one configured → shown plain, no crossfade. Neither configured →
// falls back to text, which still participates in the color swap.
import { getSiteInfo } from "../lib/data/site";
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getServicesByCategory } from "../lib/data/services";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import { SOCIAL_ICON_CLASSES, SOCIAL_LABELS } from "../lib/icons/social";
import { phoneHref } from "../lib/utils/phone";
import { BLOG_BASE } from "../lib/data/blog";

const site = await getSiteInfo();
const categories = await getAllServiceCategories();
const servicesByCategory = await Promise.all(
  categories.map(async (category) => ({
    category,
    services: await getServicesByCategory(category.id),
  }))
);
const socialLinks = await getAllSocialLinks();
// Old site keeps Pharmacy in its utility bar (external Covetrus store) — kept top level.
const PHARMACY_URL = "https://lebanonsmallanimalclinic.covetruspharmacy.com";
const allServices = servicesByCategory.flatMap(({ services }) => services);
---

<header class="header" data-header>
  <div class="header__utility">
    <div class="header__utility-inner">
      <div class="header__contact-info">
        {site.address && (
          <a class="header__utility-item header__utility-item--address" href={site.addressLink || "/contact-us"} target="_blank" rel="noopener noreferrer">
            {site.address}{site.addressLine2 ? `, ${site.addressLine2}` : ""}
          </a>
        )}
        {site.phoneNumber && (
          <a class="header__utility-item header__utility-item--phone" href={phoneHref(site)}>
            {site.phoneNumber}
          </a>
        )}
      </div>
      <div class="header__utility-actions">
        <a class="header__utility-item" href="/contact-us">Directions &amp; Contact</a>
        <a class="header__utility-item" href={PHARMACY_URL} target="_blank" rel="noopener noreferrer">Pharmacy</a>
        {socialLinks.map((social) => (
          <a
            class="header__social-link"
            href={social.data.link}
            aria-label={SOCIAL_LABELS[social.data.icon]}
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class={SOCIAL_ICON_CLASSES[social.data.icon]} aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </div>
  </div>

  <nav class="header__nav" aria-label="Primary">
    <div class="header__nav-inner">
      <button class="header__menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-menu">
        <span class="header__menu-toggle-bar" aria-hidden="true"></span>
        <span class="header__menu-toggle-bar" aria-hidden="true"></span>
        <span class="header__menu-toggle-bar" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>

      <a class="header__logo" href="/" aria-label={`${site.practiceName} home`}>
        {site.logoColor ? (
          <img class="header__logo-image" src={site.logoColor} alt={site.practiceName} />
        ) : (
          <span class="header__logo-text">{site.practiceName}</span>
        )}
      </a>

      <ul class="header__menu" id="primary-menu" data-menu>
        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            About <span class="header__caret" aria-hidden="true"></span>
          </button>
          {/* Keep How'd We Do? through any redesign: it is the only way to open the reputation widget. */}
          <ul class="header__dropdown-menu">
            <li><a href="/why-choose-us">Why Choose Us?</a></li>
            <li><a href="/meet-the-team">Our Care Team</a></li>
            <li><a href="/careers">Careers</a></li>
            <li><a href="/testimonials">Testimonials</a></li>
            <li><button type="button" class="header__dropdown-link-button" data-modal-target="reputation-widget">How'd We Do?</button></li>
          </ul>
        </li>

        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            Pet Care <span class="header__caret" aria-hidden="true"></span>
          </button>
          <ul class="header__dropdown-menu header__dropdown-menu--services">
            {allServices.map((service) => (
              <li><a href={`/services/${service.id}`}>{service.data.customName || service.data.name}</a></li>
            ))}
            <li class="header__dropdown-item--all"><a href="/services">All Pet Care</a></li>
          </ul>
        </li>

        <li class="header__menu-item"><a class="header__menu-link" href="/wellness-plans">Wellness Plans</a></li>

        <li class="header__menu-item"><a class="header__menu-link" href={BLOG_BASE}>Blog</a></li>

        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            Patient Resources <span class="header__caret" aria-hidden="true"></span>
          </button>
          <ul class="header__dropdown-menu">
            <li><a href="/what-to-expect">What to Expect</a></li>
            <li><a href="/pets-we-care-for">Pets We Care For</a></li>
            <li><a href="/payment-options">Payment Options</a></li>
            <li><a href="/urgent-care-and-house-calls">Urgent Care &amp; House Calls</a></li>
            <li><a href="/faq">FAQs</a></li>
            <li><a href="/online-forms">New Patient Forms</a></li>
          </ul>
        </li>

        {site.bookingUrl && (
          <li class="header__menu-item header__menu-item--cta">
            <a class="header__cta" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">{site.bookingLabel || "Book Now"}</a>
          </li>
        )}
      </ul>

      {site.phoneNumber && (
        <a class="header__mobile-call" href={phoneHref(site)} aria-label={`Call us at ${site.phoneNumber}`}>
          <span aria-hidden="true">&#128222;</span>
        </a>
      )}
    </div>
  </nav>
</header>

<style>
  /* Always-white sticky header with the full-color logo + deep-teal utility strip
     (agency rule). <main> is padded by --header-height in BaseLayout, so nothing
     renders underneath it. */
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    background: var(--header-bg);
    color: var(--header-fg);
    transition: box-shadow var(--motion-duration-slow) var(--motion-ease);
  }
  .header.is-scrolled { box-shadow: var(--shadow-header); }

  .header__utility { background: var(--main-dark); color: var(--white); font-size: var(--font-size-sm); }
  .header__utility-inner { max-width: var(--container-max); margin-inline: auto; padding: var(--space-xs) var(--space-md); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .header__contact-info, .header__utility-actions { display: flex; align-items: center; gap: var(--space-lg); }
  .header__utility-item, .header__social-link { color: inherit; text-decoration: none; opacity: 0.9; transition: opacity var(--motion-duration-fast) var(--motion-ease); }
  .header__utility-item:hover, .header__social-link:hover { opacity: 1; }
  .header__utility-item--phone { font-weight: 600; opacity: 1; }
  .header__utility-item--address { white-space: nowrap; }
  .header__social-link { display: inline-flex; font-size: var(--font-size-md); }

  .header__nav-inner { max-width: var(--container-max); margin-inline: auto; padding: var(--space-sm) var(--space-md); display: flex; align-items: center; gap: var(--space-lg); }
  .header__logo { display: inline-flex; margin-inline-end: auto; text-decoration: none; color: inherit; }
  .header__logo-text { font-weight: 700; font-size: var(--font-size-lg); color: inherit; }
  .header__logo-image { display: block; block-size: var(--logo-height); inline-size: auto; }

  .header__menu-toggle { display: none; flex-direction: column; gap: var(--space-2xs); background: none; border: 0; cursor: pointer; padding: var(--space-xs); color: inherit; }
  .header__menu-toggle-bar { width: 1.4rem; height: 2px; background: currentColor; display: block; }

  .header__menu { display: flex; align-items: center; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; font-family: var(--font-heading); font-weight: 600; }
  .header__menu-link { background: none; border: 0; font: inherit; color: inherit; text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35em; padding: var(--space-xs) 0; transition: color var(--motion-duration-fast) var(--motion-ease); }
  .header__menu-link:hover { color: var(--main); }
  .header__caret { width: 0.45em; height: 0.45em; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: rotate(45deg); margin-block-start: -0.2em; }

  .header__cta { display: inline-flex; align-items: center; background: var(--cta); color: var(--on-cta); padding: var(--space-sm) var(--space-lg); border-radius: var(--radius-pill); text-decoration: none; font-weight: 600; white-space: nowrap; transition: background-color var(--motion-duration-base) var(--motion-ease), transform var(--motion-duration-base) var(--motion-ease); }
  .header__cta:hover { background: var(--cta-hover); transform: translateY(-1px); }

  .header__menu-item--dropdown { position: relative; }
  .header__dropdown-menu { position: absolute; inset-block-start: 100%; inset-inline-start: calc(-1 * var(--space-md)); min-width: 15rem; background: var(--white); box-shadow: var(--shadow-dropdown); border-radius: var(--radius-md); list-style: none; margin: 0; padding: var(--space-xs) 0; z-index: 10; font-family: var(--font-body); font-weight: 500; opacity: 0; visibility: hidden; transform: translateY(var(--space-2xs)); transition: opacity var(--motion-duration-base) var(--motion-ease), transform var(--motion-duration-base) var(--motion-ease), visibility var(--motion-duration-base) var(--motion-ease); }
  .header__dropdown-toggle[aria-expanded="true"] + .header__dropdown-menu,
  .header__menu-item--dropdown:has(> [aria-expanded="true"]) > .header__dropdown-menu { opacity: 1; visibility: visible; transform: none; }
  @media (min-width: 901px) {
    .header__menu-item--dropdown:hover > .header__dropdown-menu,
    .header__menu-item--dropdown:focus-within > .header__dropdown-menu { opacity: 1; visibility: visible; transform: none; }
  }
  .header__dropdown-menu a,
  .header__dropdown-link-button { display: block; width: 100%; text-align: start; padding: var(--space-xs) var(--space-md); color: var(--heading); text-decoration: none; background: none; border: 0; font: inherit; cursor: pointer; transition: background-color var(--motion-duration-fast) var(--motion-ease); }
  .header__dropdown-menu a:hover,
  .header__dropdown-link-button:hover { background: var(--solid-bg); }
  .header__dropdown-item--all { border-block-start: 1px solid var(--light-grey); margin-block-start: var(--space-2xs); }

  .header__mobile-call { display: none; color: inherit; }

  @media (max-width: 1100px) {
    .header__contact-info .header__utility-item--address { display: none; }
    .header__menu { gap: var(--space-md); }
  }
  @media (max-width: 900px) {
    .header__menu-toggle { display: inline-flex; order: 2; }
    .header__utility-actions .header__utility-item { display: none; }
    .header__menu { position: fixed; inset-block-start: var(--header-height); inset-inline: 0; inset-block-end: 0; background: var(--white); flex-direction: column; align-items: stretch; gap: var(--space-xs); padding: var(--space-md); overflow-y: auto; transform: translateX(-100%); transition: transform var(--motion-duration-base) var(--motion-ease); color: var(--heading); }
    .header__menu.is-open { transform: translateX(0); }
    .header__dropdown-menu { position: static; box-shadow: none; padding-inline-start: var(--space-md); display: none; opacity: 1; visibility: visible; transform: none; }
    .header__dropdown-toggle[aria-expanded="true"] + .header__dropdown-menu { display: block; }
    .header__menu-item--cta { margin-block-start: var(--space-sm); }
    .header__mobile-call { display: inline-flex; align-items: center; justify-content: center; order: 1; }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  function updateHeaderScrollState() {
    header?.classList.toggle("is-scrolled", window.scrollY > 10);
  }
  updateHeaderScrollState();
  window.addEventListener("scroll", updateHeaderScrollState, { passive: true });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;

    const menuToggle = e.target.closest("[data-menu-toggle]");
    if (menuToggle) {
      const menu = document.querySelector("[data-menu]");
      const expanded = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!expanded));
      menu?.classList.toggle("is-open", !expanded);
      return;
    }

    const dropdownToggle = e.target.closest("[data-dropdown-toggle]");
    if (dropdownToggle) {
      const expanded = dropdownToggle.getAttribute("aria-expanded") === "true";
      const parentList = dropdownToggle.parentElement?.parentElement;
      parentList?.querySelectorAll(":scope > li > [data-dropdown-toggle]").forEach((btn) => {
        if (btn !== dropdownToggle) btn.setAttribute("aria-expanded", "false");
      });
      dropdownToggle.setAttribute("aria-expanded", String(!expanded));
      return;
    }

    if (!e.target.closest(".header__menu-item--dropdown")) {
      document.querySelectorAll('[data-dropdown-toggle][aria-expanded="true"]').forEach((btn) => btn.setAttribute("aria-expanded", "false"));
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.querySelectorAll('[data-dropdown-toggle][aria-expanded="true"]').forEach((btn) => btn.setAttribute("aria-expanded", "false"));
    }
  });
</script>
