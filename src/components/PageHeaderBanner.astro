---
// Interior-page banner. Lebanon design pass: every banner has a real clinic
// photo behind it (falls back to the clinic exterior), is at least 60vh and
// 500px tall (agency rule), and uses the same teal gradient scrim and eyebrow
// as the approved homepage hero. Sits below the fixed white header (<main>
// is padded by --header-height in BaseLayout).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import fallbackImage from "../assets/site/clinic-exterior.jpg";

export interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { heading, eyebrow, intro, image = fallbackImage, imageAlt = "", imagePosition = "center 40%" } = Astro.props;
---

<div class="page-header-banner">
  <Image src={image} alt={imageAlt} class="page-header-banner__image" style={`object-position: ${imagePosition}`} widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
  <div class="page-header-banner__overlay" aria-hidden="true"></div>
  <div class="page-header-banner__content">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1 class="page-header-banner__heading">{heading}</h1>
    {intro && <p class="page-header-banner__intro">{intro}</p>}
  </div>
</div>

<style>
  .page-header-banner { position: relative; display: flex; align-items: center; min-height: var(--page-header-height); background: var(--main-dark); overflow: hidden; }
  .page-header-banner__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .page-header-banner__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, var(--alt-bg) 0%, var(--main-o50) 60%, var(--overlay-soft) 100%); }
  .page-header-banner__content { position: relative; z-index: 2; width: 100%; max-width: var(--container-max); margin-inline: auto; padding: var(--space-2xl) var(--space-md); color: var(--on-main); }
  .page-header-banner__heading { margin: 0; color: inherit; font-size: var(--font-size-hero); line-height: 1.05; max-width: 48rem; }
  .page-header-banner__intro { margin: var(--space-md) 0 0; font-size: var(--font-size-lg); max-width: 36rem; }
  @media (max-width: 767px) {
    .page-header-banner__heading { font-size: var(--font-size-3xl); }
  }
</style>
