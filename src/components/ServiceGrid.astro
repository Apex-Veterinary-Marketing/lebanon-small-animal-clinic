---
// CMS-powered. Renders the services collection (or a filtered subset, e.g.
// one category) as a grid of ServiceCard. See Skeleton-Build-Spec.md §6.
import ServiceCard from "./ServiceCard.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  services: CollectionEntry<"services">[];
}
const { services } = Astro.props;
// Balanced rows: 4 or 8 cards → 4 across; anything else (3, 5, 6, 9…) → 3 across.
const cols = services.length === 4 || services.length === 8 ? 4 : 3;
---

<div class:list={["service-grid", `service-grid--${cols}`]}>
  {services.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  .service-grid { display: grid; gap: var(--space-lg); }
  .service-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .service-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .service-grid--4 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .service-grid--3, .service-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .service-grid--3, .service-grid--4 { grid-template-columns: 1fr; } }
</style>
