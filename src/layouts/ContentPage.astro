---
// Shared layout for the pages ported from the client's current site (Why Choose
// Us, Wellness Plans, What to Expect, …): banner → client copy (verbatim) with an
// optional photo beside it → optional extra sections (slot) → CTA band.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import CtaBand from "../components/CtaBand.astro";

export interface Props {
  title: string;
  titleTemplate?: "page" | "full";
  description: string;
  heading: string;
  eyebrow?: string;
  intro?: string;
  bannerImage?: ImageMetadata;
  bannerAlt?: string;
  bannerPosition?: string;
  html?: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  ctaHeading?: string;
  ctaText?: string;
  webPage?: Record<string, unknown>;
}
const {
  title, titleTemplate, description, heading, eyebrow, intro, bannerImage, bannerAlt, bannerPosition,
  html, photo, photoAlt = "", ctaHeading = "Ready to schedule a visit?",
  ctaText = "Book online or give us a call. We'll find a time that works for you and your pet.",
  webPage,
} = Astro.props;
---

<BaseLayout title={title} titleTemplate={titleTemplate} description={description} webPage={webPage}>
  <PageHeaderBanner heading={heading} eyebrow={eyebrow} intro={intro} image={bannerImage} imageAlt={bannerAlt} imagePosition={bannerPosition} />

  {html && (
    <section class="content-page">
      <div class:list={["content-page__inner", photo && "content-page__inner--with-photo"]}>
        <div class="prose" set:html={html} />
        {photo && (
          <div class="content-page__photo" data-reveal>
            <Image src={photo} alt={photoAlt} widths={[480, 800]} sizes="(max-width: 900px) 100vw, 420px" />
          </div>
        )}
      </div>
    </section>
  )}

  <slot />

  <CtaBand heading={ctaHeading} text={ctaText} />
</BaseLayout>

<style>
  .content-page { padding-block: var(--space-section); }
  .content-page__inner { max-width: var(--container-max-narrow); margin-inline: auto; padding-inline: var(--space-md); }
  .content-page__inner--with-photo { max-width: var(--container-max); display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
  .content-page__photo { position: sticky; inset-block-start: calc(var(--header-height) + var(--space-lg)); }
  .content-page__photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-float); }
  @media (max-width: 900px) {
    .content-page__inner--with-photo { grid-template-columns: 1fr; }
    .content-page__photo { position: static; order: -1; }
    .content-page__photo :global(img) { aspect-ratio: 4 / 3; }
  }
</style>
