---
// Appointment request — the clinic's Chckup (Chckvet) online booking, embedded on
// the page (portal.chckup.app allows framing). The floating Chckup chat on every
// page also offers "Book Appointment". If the clinic creates an Inline-type
// widget in its Chckup dashboard, swap the iframe for
// <div class="chckup_widget" data-widget-id="NEW-ID"></div>.
import ContentPage from "../layouts/ContentPage.astro";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";
import banner from "../assets/gallery/exam-cavalier.jpg";

const site = await getSiteInfo();
---

<ContentPage
  title="Request an Appointment"
  description="Book an appointment online with Lebanon Small Animal Clinic in Lebanon, OH. Choose a time for wellness visits, sick visits, dental care and more."
  heading="Request an appointment"
  eyebrow="Book online"
  intro="Pick a time that works for you and your pet. Same-day urgent visits? Give us a call."
  bannerImage={banner}
  bannerAlt="Dr. Tenenzapf and a technician examining a Cavalier King Charles spaniel"
  bannerPosition="65% 40%"
  ctaHeading="Prefer to talk to someone?"
  ctaText="Our team is happy to help you find the right appointment."
>
  <section class="booking">
    <div class="booking__inner">
      {site.bookingUrl && (
        <iframe
          class="booking__frame"
          src={site.bookingUrl}
          title={`Book an appointment with ${site.practiceName}`}
          loading="lazy"
          allow="geolocation; clipboard-write"
        ></iframe>
      )}
      <p class="booking__alt">
        Trouble with the form? <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Open online booking in a new tab</a>
        or call <a href={phoneHref(site)}>{site.phoneNumber}</a>.
      </p>
    </div>
  </section>
</ContentPage>

<style>
  .booking { padding-block: var(--space-section); }
  .booking__inner { max-width: var(--container-max-narrow); margin-inline: auto; padding-inline: var(--space-md); }
  .booking__frame { display: block; width: 100%; min-height: var(--booking-frame-height); border: 0; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); background: var(--white); }
  .booking__alt { margin: var(--space-md) 0 0; color: var(--text-muted); text-align: center; }
  .booking__alt a { color: var(--main); font-weight: 600; text-decoration: none; transition: color var(--motion-duration-base) var(--motion-ease); }
  .booking__alt a:hover { color: var(--cta); }
</style>
