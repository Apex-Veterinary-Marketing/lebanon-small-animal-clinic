---
// Old site: /careers/ (client copy, verbatim) + its "Apply Now" form (Gravity Form 837).
import ContentPage from "../layouts/ContentPage.astro";
import GravityFormEmbed from "../components/GravityFormEmbed.astro";
import html from "../data/pages/careers.html?raw";
import banner from "../assets/site/team-group.jpg";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";
const site = await getSiteInfo();
---

<ContentPage
  title="Careers"
  description="Love pets and people? Join the Lebanon Small Animal Clinic team in Lebanon, OH. We're always looking for caring team members who make a daily difference."
  heading="Join our clinic family"
  eyebrow="Careers"
  bannerImage={banner}
  bannerAlt="The Lebanon Small Animal Clinic care team"
  html={html}
  ctaHeading="Questions about working with us?"
  ctaText="Give us a call or stop by. We'd love to meet you."
>
  <section class="careers-apply">
    <div class="careers-apply__inner">
      <div class="careers-apply__form">
        <GravityFormEmbed formId="careers" context="general-info" heading="Apply now" />
      </div>
      <p class="careers-apply__alt">Prefer to talk first? Call us at <a href={phoneHref(site)}>{site.phoneNumber}</a>.</p>
    </div>
  </section>
</ContentPage>

<style>
  .careers-apply { padding-block-end: var(--space-section); }
  .careers-apply__inner { max-width: var(--container-max-narrow); margin-inline: auto; padding-inline: var(--space-md); }
  .careers-apply__form { padding: var(--space-lg); background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .careers-apply__alt { margin: var(--space-lg) 0 0; color: var(--text-muted); }
</style>
