---
// Community Outreach — new page requested by the client (HubSpot ticket
// 2026-11-05: "Add a tab at the top of the website for Community Outreach").
// AGENCY-WRITTEN, needs client review. Facts only from the client's own sources:
// the current site's "Rooted in Community" copy (4-H Clubs, Warren County Career
// Center, PAWS for Heroes, rescue groups) and the onboarding form (local schools,
// school sports teams, community events). Add photos/events when the client sends them.
import { Image } from "astro:assets";
import ContentPage from "../layouts/ContentPage.astro";
import banner from "../assets/gallery/team-at-the-barn.jpg";
import photo from "../assets/gallery/team-with-dogs-outside.jpg";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";
import { events, isPast } from "../data/events";

const site = await getSiteInfo();
// Upcoming: soonest first. Past: most recent first.
const upcoming = events.filter((e) => !isPast(e)).sort((a, b) => a.start.localeCompare(b.start));
const past = events.filter((e) => isPast(e)).sort((a, b) => b.start.localeCompare(a.start));

const causes = [
  { name: "Local 4-H Clubs", text: "Supporting the young people raising and caring for animals across Warren County." },
  { name: "Warren County Career Center", text: "Helping students explore careers in animal care and veterinary medicine." },
  { name: "PAWS for Heroes", text: "Proudly supporting PAWS for Heroes and the people it serves." },
  { name: "Animal rescue groups", text: "Giving back to rescue organizations across the region that help pets find their families." },
  { name: "Local schools & teams", text: "Cheering on our hometown schools and the student athletes who wear our logo on their shirts." },
  { name: "Community events", text: "Showing up at local events to meet neighbors, answer pet questions and share a few treats." },
];
---

<ContentPage
  title="Community Outreach"
  description="Lebanon Small Animal Clinic gives back to 4-H Clubs, the Warren County Career Center, PAWS for Heroes, local schools and rescue groups around Lebanon, OH."
  heading="Rooted in our community"
  eyebrow="Community outreach"
  intro="Caring for pets means caring for the people who love them, and for the hometown we share."
  bannerImage={banner}
  bannerAlt="Team members walking dogs outside a barn"
  bannerPosition="center 30%"
  ctaHeading="Have an event or cause we should know about?"
  ctaText="We love hearing from neighbors. Give us a call or stop by the clinic."
>
  <section class="events" id="events">
    <div class="community__inner">
      <div class="events__head">
        <p class="eyebrow">Events</p>
        <h2>Community events</h2>
        <p>Come celebrate with us! Here's what's coming up, plus a look back at past events.</p>
      </div>

      <details class="events__group" open>
        <summary class="events__summary">Upcoming events <span class="events__count" data-count-upcoming>{upcoming.length}</span></summary>
        <div class="events__list" data-events-upcoming>
          {upcoming.map((e) => (
            <article class="event" id={e.slug} data-event-end={e.end}>
              {e.image && (
                <a class="event__media" href={e.image.src} target="_blank" rel="noopener" aria-label={`Open the ${e.title} flyer full size`}>
                  <Image src={e.image} alt={e.imageAlt || e.title} class="event__image" widths={[400, 800]} sizes="(max-width: 900px) 100vw, 380px" />
                </a>
              )}
              <div class="event__body">
                <h3 class="event__title">{e.title}</h3>
                {e.subtitle && <p class="event__subtitle">{e.subtitle}</p>}
                <p class="event__when">{e.when}</p>
                <p class="event__where">{e.where}</p>
                <p class="event__summary">{e.summary}</p>
                <ul class="event__details">
                  {e.details.map((d) => <li set:html={d} />)}
                </ul>
                <p class="event__questions">Questions? Call <a href={phoneHref(site)}>{site.phoneNumber}</a>.</p>
              </div>
              {e.gallery && e.gallery.length > 0 && e.galleryHeading && <h4 class="event__gallery-heading">{e.galleryHeading}</h4>}
              {e.gallery && e.gallery.length > 0 && (
                <ul class="event__gallery">
                  {e.gallery.map((g) => (
                    <li><Image src={g.src} alt={g.alt} class="event__gallery-img" widths={[300, 600]} sizes="(max-width: 767px) 50vw, 260px" /></li>
                  ))}
                </ul>
              )}
            </article>
          ))}
          <p class="events__empty" data-empty-upcoming hidden={upcoming.length > 0}>No upcoming events right now. Check back soon or follow us on social media for news.</p>
        </div>
      </details>

      <details class="events__group">
        <summary class="events__summary">Past events <span class="events__count" data-count-past>{past.length}</span></summary>
        <div class="events__list" data-events-past>
          {past.map((e) => (
            <article class="event event--past" id={e.slug}>
              {e.image && <div class="event__media"><Image src={e.image} alt={e.imageAlt || e.title} class="event__image" widths={[400, 800]} sizes="(max-width: 900px) 100vw, 380px" /></div>}
              <div class="event__body">
                <h3 class="event__title">{e.title}</h3>
                {e.subtitle && <p class="event__subtitle">{e.subtitle}</p>}
                <p class="event__when">{e.when}</p>
                <p class="event__summary">{e.summary}</p>
              </div>
              {e.gallery && e.gallery.length > 0 && e.galleryHeading && <h4 class="event__gallery-heading">{e.galleryHeading}</h4>}
              {e.gallery && e.gallery.length > 0 && (
                <ul class="event__gallery">
                  {e.gallery.map((g) => (
                    <li><Image src={g.src} alt={g.alt} class="event__gallery-img" widths={[300, 600]} sizes="(max-width: 767px) 50vw, 260px" /></li>
                  ))}
                </ul>
              )}
            </article>
          ))}
          <p class="events__empty" data-empty-past hidden={past.length > 0}>Photos and highlights from our past events will appear here.</p>
        </div>
      </details>
    </div>
  </section>

  <section class="community">
    <div class="community__inner">
      <div class="community__intro">
        <div class="prose">
          <p>When you choose Lebanon Small Animal Clinic, you're supporting a practice that's deeply rooted in the community. As a hometown veterinary clinic, being part of Lebanon and the towns around it matters to us, and our relationships reach well beyond the exam room.</p>
          <p>We proudly give back to local 4-H Clubs, the Warren County Career Center, PAWS for Heroes and animal rescue groups across the region. You'll also find us supporting local schools and sports teams and taking part in community events throughout the year.</p>
        </div>
        <Image class="community__photo" src={photo} alt="Team members greeting dogs outdoors" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
      <ul class="community__grid">
        {causes.map((c) => (
          <li class="community__card" data-reveal>
            <h3>{c.name}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</ContentPage>

<script>
  // A visitor on a stale build still sees a finished event under Past events.
  const upcomingList = document.querySelector("[data-events-upcoming]");
  const pastList = document.querySelector("[data-events-past]");
  if (upcomingList && pastList) {
    let moved = 0;
    upcomingList.querySelectorAll<HTMLElement>("[data-event-end]").forEach((el) => {
      if (new Date(el.dataset.eventEnd || "").getTime() < Date.now()) {
        el.classList.add("event--past");
        pastList.prepend(el);
        moved++;
      }
    });
    if (moved) {
      const up = upcomingList.querySelectorAll(".event").length;
      const pastCount = pastList.querySelectorAll(".event").length;
      const setText = (sel: string, v: string) => { const n = document.querySelector(sel); if (n) n.textContent = v; };
      setText("[data-count-upcoming]", String(up));
      setText("[data-count-past]", String(pastCount));
      const eu = document.querySelector<HTMLElement>("[data-empty-upcoming]");
      const ep = document.querySelector<HTMLElement>("[data-empty-past]");
      if (eu) eu.hidden = up > 0;
      if (ep) ep.hidden = pastCount > 0;
    }
  }
  // Opening /community-outreach#<event> (e.g. from the popup) opens that event's group.
  if (location.hash) {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const group = target?.closest("details");
    if (target && group) { group.open = true; target.scrollIntoView(); }
  }
</script>

<style>
  .events { padding-block: var(--space-section) 0; }
  .events__head { max-width: 44rem; margin: 0 auto var(--space-xl); text-align: center; }
  .events__head h2 { font-size: var(--font-size-3xl); margin: 0 0 var(--space-sm); }
  .events__head p:last-child { margin: 0; color: var(--text-muted); }
  .events__group { margin-block-end: var(--space-md); background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .events__summary { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-md) var(--space-lg); cursor: pointer; list-style: none; font-family: var(--font-heading); font-weight: 700; font-size: var(--font-size-xl); color: var(--heading); }
  .events__summary::-webkit-details-marker { display: none; }
  .events__summary::after { content: "+"; margin-inline-start: auto; font-size: var(--font-size-2xl); color: var(--main); transition: transform var(--motion-duration-base) var(--motion-ease); }
  .events__group[open] > .events__summary::after { transform: rotate(45deg); }
  .events__count { display: inline-grid; place-items: center; min-width: 1.75rem; height: 1.75rem; padding-inline: var(--space-2xs); border-radius: var(--radius-pill); background: var(--solid-bg); color: var(--main); font-size: var(--font-size-sm); }
  .events__list { padding: 0 var(--space-lg) var(--space-lg); display: grid; gap: var(--space-lg); }
  .events__empty { margin: 0; color: var(--text-muted); }
  .event { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-xl); align-items: start; padding-block-start: var(--space-lg); border-block-start: 1px solid var(--solid-bg); scroll-margin-block-start: 8rem; }
  .event__media { display: block; }
  .event__image { width: 100%; height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .event__title { margin: 0 0 var(--space-xs); font-size: var(--font-size-2xl); }
  .event__subtitle { margin: 0 0 var(--space-sm); font-family: var(--font-heading); font-weight: 600; font-size: var(--font-size-lg); color: var(--main); }
  .event__when { margin: 0; font-weight: 700; color: var(--cta); }
  .event__where { margin: var(--space-2xs) 0 var(--space-md); color: var(--text-muted); }
  .event__summary { margin: 0 0 var(--space-md); }
  .event__details { margin: 0 0 var(--space-md); padding-inline-start: var(--space-lg); display: grid; gap: var(--space-xs); }
  .event__questions { margin: 0; font-weight: 600; }
  .event__questions a { color: var(--main); text-decoration: none; transition: color var(--motion-duration-base) var(--motion-ease); }
  .event__questions a:hover { color: var(--cta); }
  .event__gallery-heading { grid-column: 1 / -1; margin: 0; font-size: var(--font-size-lg); }
  .event__gallery { grid-column: 1 / -1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-md); }
  .event__gallery-img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-md); }
  .community { padding-block: var(--space-section); }
  .community__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-md); }
  .community__intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: center; margin-block-end: var(--space-2xl); }
  .community__photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-float); }
  .community__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .community__card { padding: var(--space-lg); background: var(--solid-bg); border-radius: var(--radius-lg); border-block-start: 4px solid var(--cta); }
  .community__card h3 { margin: 0 0 var(--space-xs); font-size: var(--font-size-lg); }
  .community__card p { margin: 0; color: var(--text-muted); }
  @media (max-width: 900px) {
    .event { grid-template-columns: 1fr; }
    .event__media { max-width: 26rem; }
    .event__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .community__intro { grid-template-columns: 1fr; }
    .community__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .community__grid { grid-template-columns: 1fr; }
  }
</style>
