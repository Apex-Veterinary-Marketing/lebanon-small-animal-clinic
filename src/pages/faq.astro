---
// Lebanon: the client's own FAQs from their current /patient-resources/faqs/
// page (verbatim). Service FAQs stay on each service page (175 of them made this page unusable on phones).
import ContentPage from "../layouts/ContentPage.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { getSiteInfo } from "../lib/data/site";
import { withTrackingPhone } from "../lib/utils/phone";
import faqHtml from "../data/pages/faq.html?raw";
import banner from "../assets/gallery/fluffy-cat.jpg";

// faq.html = intro paragraphs, then one <h3>question</h3> + answer HTML per FAQ.
const [intro, ...rest] = faqHtml.split(/<h3>/);
const clientFaqs = rest.map((chunk) => {
  const [question, answer] = chunk.split("</h3>");
  return { question: question.replace(/<[^>]+>/g, "").trim(), answer: answer.trim() };
});
// Service FAQ answers carry tel: links — route them through the tracking number like the service pages do.
const site = await getSiteInfo();
const faqs = await Promise.all([...clientFaqs].map(async (f) => ({ ...f, answer: await withTrackingPhone(f.answer, site) })));
---

<ContentPage
  title="Patient Resources - FAQs | Lebanon Small Animal Clinic"
  titleTemplate="full"
  description="Here are answers to some of the most common questions we hear—from appointment details to pet care tips—to help you feel confident & informed for your visit."
  heading="Frequently asked questions"
  eyebrow="Patient resources"
  bannerImage={banner}
  bannerAlt="A fluffy cat at the clinic"
  ctaHeading="Still have a question?"
  ctaText="Our team is happy to help. Give us a call or book a visit."
  webPage={{ "@type": "FAQPage" }}
>
  <section class="faq-page">
    <div class="faq-page__inner">
      <div class="prose faq-page__intro" set:html={intro} />
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</ContentPage>

<style>
  .faq-page { padding-block: var(--space-section); }
  .faq-page__inner { max-width: var(--container-max-narrow); margin-inline: auto; padding-inline: var(--space-md); }
  .faq-page__intro { margin-block-end: var(--space-xl); }
</style>
