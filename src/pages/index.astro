---
// Lebanon Small Animal Clinic homepage — "warm hometown" direction, built on the
// colors and fonts of the client's current site (teal + raspberry, Parkinsans +
// Poppins) and their own photos. Story order: hometown welcome → who we treat →
// what we do → why families stay → the two doctors → what clients say → visit us.
// Highlights (Fear Free, urgent care, exotics, award) appear ONCE, as hero pills.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceGrid from "../components/ServiceGrid.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import { getFeaturedServices } from "../lib/data/services";
import { getHomeDoctors } from "../lib/data/doctors";
import { getSiteInfo } from "../lib/data/site";
import { getAllTestimonials } from "../lib/data/testimonials";
import { phoneHref } from "../lib/utils/phone";

import heroVetDog from "../assets/site/hero-vet-with-dog.jpg";
import heroChickens from "../assets/site/chickens.jpg";
import heroTeam from "../assets/site/team-group.jpg";
import clinicExterior from "../assets/site/clinic-exterior.jpg";
import microscope from "../assets/site/microscope.jpg";
import petDog from "../assets/site/pets-DSC02617.jpg";
import petCat from "../assets/site/pets-DSC02675.jpg";
import petPocket from "../assets/site/hedgehog.jpg";
import petFarm from "../assets/site/pets-DSC03361.jpg";
import awardBadge from "../assets/site/award-businessrate-crystal.png";
// Official logo from catvets.com (Feline Veterinary Medical Association); the old site says its vets are Feline/Cat Friendly certified.
import catFriendlyBadge from "../assets/site/badge-cat-friendly-veterinarian.png";
import logoCherry from "../assets/site/logo-cherry.png";
import logoCareCredit from "../assets/site/logo-carecredit.jpg";

const site = await getSiteInfo();
const featuredServices = (await getFeaturedServices()).slice(0, 6);
const doctors = await getHomeDoctors();
const testimonials = await getAllTestimonials();

const heroSlides = [
  { src: heroVetDog, alt: "Lebanon Small Animal Clinic team member smiling with a golden dog", position: "70% 30%" },
  { src: heroChickens, alt: "Two Lebanon Small Animal Clinic team members holding chickens at a farm", position: "50% 35%" },
  { src: heroTeam, alt: "The Lebanon Small Animal Clinic care team in the clinic lobby", position: "50% 40%" },
];

const highlights = [
  "Fear Free Certified",
  "Cat Friendly",
  "Same-day urgent care",
  "Exotics & farm animals",
  "2025 Best Veterinarian, Turtlecreek Township",
];

const pets = [
  { name: "Dogs", src: petDog, alt: "Dr. Hassel and a team member examining two puppies" },
  { name: "Cats", src: petCat, alt: "Team member petting a gray kitten" },
  { name: "Exotics & Pocket Pets", src: petPocket, alt: "Hedgehog held in a pair of hands" },
  { name: "Farm Animals", src: petFarm, alt: "Two team members holding baby goats in the hay" },
];

const doctorRoles: Record<string, string> = {
  "dr-halley-hassel": "Owner & Veterinarian",
  "dr-jonathan-tenenzapf": "Associate Veterinarian",
};
---

<BaseLayout
  title={`${site.practiceName} | Veterinarian in Lebanon, OH`}
  titleTemplate="full"
  description="Fear Free vet in Lebanon, OH: wellness exams, same-day urgent care, surgery and dentistry for dogs, cats, exotics and farm animals. Call (513) 932-4189."
>
  <!-- HERO: photo slider of the client's own team and patients -->
  <section class="home-hero" aria-label="Welcome">
    <div class="home-hero__slides" data-hero-slider>
      {heroSlides.map((slide, i) => (
        <Image
          src={slide.src}
          alt={slide.alt}
          class:list={["home-hero__slide", i === 0 && "is-active"]}
          style={`object-position: ${slide.position}`}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
        />
      ))}
    </div>
    <div class="home-hero__scrim" aria-hidden="true"></div>
    <div class="home-hero__inner">
      <div class="home-hero__content">
        <p class="eyebrow eyebrow--light">Your hometown vet in Lebanon, Ohio</p>
        <h1 class="home-hero__heading">Health, Happiness &amp; Homegrown Care</h1>
        <p class="home-hero__sub">Small-town heart with big-city veterinary care for dogs, cats, exotics and farm animals.</p>
        <div class="home-hero__actions">
          {site.bookingUrl && (
            <a class="btn btn--cta btn--lg" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">{site.bookingLabel}</a>
          )}
          {site.phoneNumber && <a class="btn btn--ghost-light btn--lg" href={phoneHref(site)}>Call {site.phoneNumber}</a>}
        </div>
      </div>
      <ul class="home-hero__pills" aria-label="Why families choose us">
        {highlights.map((h) => <li class="pill">{h}</li>)}
      </ul>
    </div>
    <div class="home-hero__dots" role="group" aria-label="Choose a photo">
      {heroSlides.map((_, i) => (
        <button type="button" class:list={["home-hero__dot", i === 0 && "is-active"]} data-hero-dot={i} aria-label={`Show photo ${i + 1}`}></button>
      ))}
    </div>
  </section>

  <!-- WELCOME -->
  <section class="home-section">
    <div class="home-container home-split">
      <div class="home-split__media" data-reveal="left">
        <Image src={clinicExterior} alt="Lebanon Small Animal Clinic on Oregonia Road, with the clinic's teal vintage truck parked out front" class="home-photo" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 560px" />
      </div>
      <div class="home-split__copy" data-reveal="right">
        <p class="eyebrow">Welcome to the family</p>
        <h2>Wellness starts here</h2>
        <p>At Lebanon Small Animal Clinic, we know your pet is family. Proud to be named <strong>2025 Best Veterinarian in Turtlecreek Township</strong> and a <strong>2026 Best of BusinessRate</strong> winner, we're committed to making proactive care easy to access and every visit as peaceful and reassuring as possible for both you and your pet.</p>
        <p>You'll be welcomed by Care Companions who've worked together for over 20 years, providing expert care in medicine, surgery, and preventive wellness. As USDA-accredited veterinarians, we're equipped to offer advanced treatment when it's needed, without ever losing sight of your pet's comfort.</p>
        <p>Our doctors and staff are <strong>Fear Free Certified</strong>, with veterinarians who are also <strong>Feline Friendly Certified</strong>. These certifications reflect our commitment to creating a calming environment for every pet, especially those who need a little extra reassurance. We've even created a dedicated space in the clinic just for cats to help reduce stress during their visits.</p>
        <p>For pets who feel more comfortable at home, we also offer convenient house calls to bring care right to your door. Whether your pet comes to the clinic or we visit your home, every appointment is built around trust, comfort, and the kind of care that helps them feel safe and loved.</p>
        <div class="welcome-actions">
          <a class="btn btn--main" href="/meet-the-team">Meet our care team</a>
          <Image src={awardBadge} alt="Best of 2026 BusinessRate award winner: Lebanon Small Animal Clinic, Veterinarian, Lebanon, Ohio" class="award-badge" height={150} />
          <Image src={catFriendlyBadge} alt="Cat Friendly Veterinarian, Feline Veterinary Medical Association" class="cert-badge" height={90} />
        </div>
      </div>
    </div>
  </section>

  <!-- PETS WE CARE FOR -->
  <section class="home-section home-section--soft">
    <div class="home-container">
      <div class="home-intro" data-reveal>
        <p class="eyebrow">Pets we care for</p>
        <h2>Not just a dog-and-cat clinic</h2>
        <p>From family dogs and cats to rabbits, hedgehogs, reptiles, birds, goats and chickens, every patient gets the same gentle, knowledgeable care.</p>
      </div>
      <ul class="pet-row" data-reveal-stagger>
        {pets.map((pet) => (
          <li class="pet-card" data-reveal>
            <Image src={pet.src} alt={pet.alt} class="pet-card__photo" widths={[320, 480]} sizes="(max-width: 767px) 50vw, 220px" />
            <span class="pet-card__name">{pet.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICES -->
  {featuredServices.length > 0 && (
    <section class="home-section">
      <div class="home-container">
        <div class="home-intro" data-reveal>
          <p class="eyebrow">Pet care</p>
          <h2>Care for every stage of your pet's life</h2>
          <p>Wellness visits, diagnostics, dentistry, surgery and same-day urgent care, all under one roof in Lebanon.</p>
        </div>
        <div data-reveal>
          <ServiceGrid services={featuredServices} />
        </div>
        <div class="home-center">
          <a class="btn btn--outline" href="/services">See all pet care</a>
        </div>
      </div>
    </section>
  )}

  <!-- WHY FAMILIES STAY -->
  <section class="home-section home-section--dark">
    <div class="home-container home-split home-split--reverse">
      <div class="home-split__media" data-reveal="right">
        <Image src={microscope} alt="Lebanon Small Animal Clinic team member reviewing a sample under the microscope" class="home-photo" widths={[600, 900]} sizes="(max-width: 900px) 100vw, 560px" />
      </div>
      <div class="home-split__copy" data-reveal="left">
        <p class="eyebrow eyebrow--light">PAWS wellness plans</p>
        <h2>Happy pets, healthy hearts</h2>
        <p>We make it easier than ever to keep your pet healthy and happy. From online booking and an emergency hotline to in-home appointments, we offer care options that work for your life.</p>
        <p>Our PAWS Plans give members access to comprehensive wellness care, including routine checkups, vaccinations, spay/neuter procedures, dental cleanings, and x-rays. These customizable memberships are designed to catch health concerns early, prevent illness, and reduce stress at every step.</p>
        <p>When your pet is thriving, so is your family. Schedule a visit for care that keeps tails wagging, whiskers twitching, and turns every vet visit into a treat.</p>
        <div class="home-actions">
          {site.bookingUrl && (
            <a class="btn btn--cta" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">{site.bookingLabel}</a>
          )}
          <a class="btn btn--ghost-light" href="/wellness-plans">Explore PAWS Plans</a>
        </div>
      </div>
    </div>
  </section>

  <!-- DOCTORS -->
  {doctors.length > 0 && (
    <section class="home-section home-section--soft">
      <div class="home-container">
        <div class="home-intro" data-reveal>
          <p class="eyebrow">Our veterinarians</p>
          <h2>Meet the doctors</h2>
        </div>
        <div class="doc-row" data-reveal-stagger>
          {doctors.map((doctor) => (
            <article class="doc-card" data-reveal>
              {doctor.data.mainImage && (
                <Image src={doctor.data.mainImage} alt={doctor.data.imageAltText || doctor.data.name} class="doc-card__photo" widths={[320, 560]} sizes="(max-width: 767px) 100vw, 260px" />
              )}
              <div class="doc-card__body">
                <h3 class="doc-card__name">{doctor.data.name}</h3>
                {doctorRoles[doctor.id] && <p class="doc-card__role">{doctorRoles[doctor.id]}</p>}
                {doctor.data.bioShort && <div class="doc-card__bio" set:html={doctor.data.bioShort} />}
                <a class="doc-card__link" href={`/doctors/${doctor.id}`}>Read full bio <span aria-hidden="true">&rarr;</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TESTIMONIALS -->
  {testimonials.length > 0 && (
    <section class="home-section home-section--teal">
      <div class="home-container home-container--narrow">
        <div class="home-intro" data-reveal>
          <p class="eyebrow eyebrow--light">Kind words</p>
          <h2>What our clients say</h2>
        </div>
        <TestimonialSlider
          testimonials={testimonials.map((t) => ({
            name: t.data.name,
            testimonial: t.data.testimonial,
            image: t.data.image,
            imageAltText: t.data.imageAltText,
          }))}
        />
        <div class="home-center home-actions">
          <a class="btn btn--cta" href="/testimonials">Read all testimonials</a>
          {site.googleReviewsLink && (
            <a class="btn btn--ghost-light" href={site.googleReviewsLink} target="_blank" rel="noopener noreferrer">Leave us a Google review</a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- VISIT US -->
  <section class="home-section">
    <div class="home-container visit">
      <div class="visit__info" data-reveal>
        <p class="eyebrow">Visit us</p>
        <h2>Come see us in Lebanon</h2>
        {(site.address || site.addressLine2) && (
          <p class="visit__address">
            {site.addressLink ? (
              <a href={site.addressLink} target="_blank" rel="noopener noreferrer">{site.address}<br />{site.addressLine2}</a>
            ) : (
              <>{site.address}<br />{site.addressLine2}</>
            )}
          </p>
        )}
        {site.phoneNumber && <p class="visit__phone"><a href={phoneHref(site)}>{site.phoneNumber}</a></p>}
        {site.hours && (
          <div class="visit__hours">
            <h3>Hours</h3>
            <div set:html={site.hours} />
            <p class="visit__note">Emergency and urgent care: 8 AM to 6 PM, Monday through Friday. Weekends: call <a href={phoneHref(site)}>{site.phoneNumber}</a>.</p>
          </div>
        )}
        <div class="visit__pay">
          <h3>Flexible ways to pay</h3>
          <p>Cash, check, Visa, MasterCard, Amex, Discover, PAWS wellness plans and financing through:</p>
          <div class="visit__logos">
            <Image src={logoCherry} alt="Cherry payment plans" class="visit__logo" height={36} />
            <Image src={logoCareCredit} alt="CareCredit" class="visit__logo" height={30} />
          </div>
        </div>
      </div>
      {site.mapEmbedLink && (
        <div class="visit__map" data-reveal>
          <iframe src={site.mapEmbedLink} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Map to ${site.practiceName}`}></iframe>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Hero photo slider: crossfades every few seconds; dots jump to a photo.
  // Respects reduced motion (stays on the first photo, dots still work).
  const slides = Array.from(document.querySelectorAll<HTMLElement>(".home-hero__slide"));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hero-dot]"));
  let current = 0;
  let timer: number | undefined;
  function show(index: number) {
    current = (index + slides.length) % slides.length;
    slides.forEach((s, i) => s.classList.toggle("is-active", i === current));
    dots.forEach((d, i) => {
      d.classList.toggle("is-active", i === current);
      d.setAttribute("aria-pressed", String(i === current));
    });
  }
  function start() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || slides.length < 2) return;
    window.clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), 6000);
  }
  dots.forEach((dot) => dot.addEventListener("click", () => { show(Number(dot.dataset.heroDot)); start(); }));
  show(0);
  start();
</script>

<style>
  .home-container { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-md); }
  .home-container--narrow { max-width: var(--container-max-narrow); }
  .home-section { padding-block: var(--space-section); }
  .home-section--soft { background: var(--solid-bg); }
  .home-section--dark { background: var(--main-dark); color: var(--white); }
  .home-section--teal { background: var(--main); color: var(--white); }
  .home-section--dark :is(h2, h3), .home-section--teal :is(h2, h3) { color: inherit; }
  .home-section--teal :global(:is(h3, p, button, a)) { color: inherit; }
  .home-intro { max-width: 44rem; margin: 0 auto var(--space-xl); text-align: center; }
  .home-intro p:last-child { margin-block-end: 0; }
  .home-center { display: flex; justify-content: center; margin-block-start: var(--space-xl); }
  h2 { font-size: var(--font-size-3xl); line-height: 1.15; margin: 0 0 var(--space-md); }

  .home-photo { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-float); }

  .home-split { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: var(--space-2xl); }
  .home-split--reverse .home-split__media { order: 2; }
  .home-split__copy p { margin: 0 0 var(--space-md); }
  .home-split__copy .btn { margin-block-start: var(--space-sm); }
  .welcome-actions, .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md); margin-block-start: var(--space-sm); }
  .welcome-actions .btn, .home-actions .btn { margin-block-start: 0; }
  .award-badge { width: auto; height: 9.5rem; }
  .cert-badge { width: auto; height: 4.5rem; }
  .visit__note { margin: var(--space-xs) 0 0; color: var(--text-muted); }
  .visit__note a { color: var(--main); font-weight: 600; text-decoration: none; }

  /* Hero */
  .home-hero { position: relative; min-height: calc(100dvh - var(--header-height)); display: flex; flex-direction: column; justify-content: center; color: var(--white); overflow: hidden; background: var(--main-dark); }
  .home-hero__slides { position: absolute; inset: 0; }
  .home-hero__slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity var(--motion-duration-hero) var(--motion-ease); }
  .home-hero__slide.is-active { opacity: 1; }
  .home-hero__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, var(--alt-bg) 0%, var(--main-o50) 55%, var(--overlay-soft) 100%); }
  .home-hero__inner { position: relative; z-index: 1; width: 100%; max-width: var(--container-max); margin-inline: auto; padding: var(--space-2xl) var(--space-md); }
  .home-hero__content { max-width: 50rem; }
  .home-hero__heading { color: inherit; font-size: var(--font-size-hero); line-height: 1.05; margin: 0 0 var(--space-md); }
  .home-hero__sub { font-size: var(--font-size-lg); margin: 0 0 var(--space-lg); max-width: 34rem; }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .home-hero__pills { list-style: none; margin: var(--space-2xl) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); max-width: 48rem; }
  .home-hero__dots { position: absolute; z-index: 1; inset-block-end: var(--space-lg); inset-inline-end: var(--space-lg); display: flex; gap: var(--space-xs); }
  .home-hero__dot { width: 0.75rem; height: 0.75rem; border-radius: var(--radius-pill); border: 2px solid var(--white); background: transparent; padding: 0; cursor: pointer; transition: background-color var(--motion-duration-base) var(--motion-ease), width var(--motion-duration-base) var(--motion-ease); }
  .home-hero__dot.is-active { background: var(--white); width: 1.75rem; }

  /* Pets */
  .pet-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-lg); }
  .pet-card { display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
  .pet-card__photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); transition: transform var(--motion-duration-base) var(--motion-ease); }
  .pet-card:hover .pet-card__photo { transform: translateY(-4px); }
  .pet-card__name { font-family: var(--font-heading); font-weight: 600; font-size: var(--font-size-lg); color: var(--heading); }

  /* Doctors */
  .doc-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl); max-width: 64rem; margin-inline: auto; }
  .doc-card { display: grid; grid-template-columns: 13rem 1fr; gap: var(--space-lg); background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); overflow: hidden; }
  .doc-card__photo { width: 100%; height: 100%; min-height: 17rem; object-fit: cover; object-position: center 20%; }
  .doc-card__body { padding: var(--space-lg) var(--space-lg) var(--space-lg) 0; display: flex; flex-direction: column; }
  .doc-card__name { margin: 0; font-size: var(--font-size-lg); }
  .doc-card__role { margin: var(--space-2xs) 0 var(--space-sm); color: var(--cta); font-weight: 600; font-size: var(--font-size-sm); }
  .doc-card__bio { color: var(--text-muted); font-size: var(--font-size-sm); }
  .doc-card__bio :global(p) { margin: 0; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .doc-card__link { margin-block-start: auto; padding-block-start: var(--space-md); font-weight: 600; text-decoration: none; transition: color var(--motion-duration-fast) var(--motion-ease); }
  .doc-card__link:hover { color: var(--cta); }

  /* Visit */
  .visit { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-2xl); align-items: stretch; }
  .visit__address, .visit__phone { margin: 0 0 var(--space-sm); font-size: var(--font-size-md); }
  .visit__address a, .visit__phone a { text-decoration: none; color: var(--text); transition: color var(--motion-duration-fast) var(--motion-ease); }
  .visit__phone a { font-weight: 700; color: var(--main); }
  .visit__address a:hover, .visit__phone a:hover { color: var(--cta); }
  .visit h3 { font-size: var(--font-size-md); margin: var(--space-lg) 0 var(--space-xs); }
  .visit__hours :global(p), .visit__pay p { margin: 0; color: var(--text-muted); }
  .visit__logos { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-lg); margin-block-start: var(--space-sm); }
  .visit__logo { width: auto; }
  .visit__map iframe { width: 100%; height: 100%; min-height: 26rem; border: 0; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }

  @media (max-width: 900px) {
    .home-split, .visit { grid-template-columns: 1fr; gap: var(--space-xl); }
    .home-split--reverse .home-split__media { order: 0; }
    .pet-row { grid-template-columns: repeat(2, 1fr); }
    .doc-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 767px) {
    h2 { font-size: var(--font-size-2xl); }
    .home-hero { min-height: auto; }
    .home-hero__heading { font-size: var(--font-size-4xl); }
    .home-hero__actions .btn { width: 100%; justify-content: center; }
    .home-hero__pills { margin-block-start: var(--space-xl); }
    .pet-row { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
    .doc-card { grid-template-columns: 1fr; }
    .doc-card__photo { aspect-ratio: 4 / 3; min-height: 0; }
    .doc-card__body { padding: 0 var(--space-lg) var(--space-lg); }
  }
</style>
