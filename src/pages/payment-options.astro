---
// Old site: /patient-resources/payment-options/ + /cherry-payments/ (Cherry
// widget) combined. Copy from the old page; brand logos are the real ones from
// the old site.
import { Image } from "astro:assets";
import ContentPage from "../layouts/ContentPage.astro";
import CherryWidget from "../components/CherryWidget.astro";
import banner from "../assets/gallery/calming-room-dog.jpg";
import logoCherry from "../assets/site/logo-cherry.png";
import logoCareCredit from "../assets/site/logo-carecredit.jpg";
import logoPawlicy from "../assets/site/logo-pawlicy.jpg";
import logoNationwide from "../assets/site/logo-nationwide.jpg";

const options = [
  { name: "Cherry", href: "#cherry", logo: logoCherry, cta: "See Cherry plans", text: "Flexible monthly payment plans for your pet's care. See your options and apply below in minutes." },
  { name: "CareCredit", href: "https://www.carecredit.com/doctor-locator/General-Practice-in-LEBANON-OH-45036/Lebanon-Small-Animal-Clinic/", logo: logoCareCredit, cta: "Visit CareCredit", text: "A credit line with extended payment plans. Apply at our hospital, privately online or over the phone." },
  { name: "Pawlicy Advisor", href: "https://www.pawlicy.com/", logo: logoPawlicy, cta: "Visit Pawlicy Advisor", text: "Compare pet insurance plans side by side to find the coverage that fits your pet." },
  { name: "Pet Insurance", href: "https://www.petinsurance.com/", logo: logoNationwide, cta: "Visit Nationwide Pet Insurance", text: "We can send records to your insurance provider; you pay at the visit and your insurer reimburses you under your policy." },
];
---

<ContentPage
  title="Payment Options"
  description="Pay for your pet's care your way at Lebanon Small Animal Clinic: cash, check, major cards, PAWS wellness plans, Cherry and CareCredit financing."
  heading="Payment options"
  eyebrow="Patient resources"
  intro="We offer several payment options to make veterinary care more accessible and manageable for your family."
  bannerImage={banner}
  bannerAlt="Team member with a dog in the clinic's calming room"
>
  <section class="pay">
    <div class="pay__inner">
      <div class="prose pay__intro">
        <p>Whether you're paying at the time of service or exploring financing, our team is here to help you choose the option that works best for your needs. We accept cash, checks, Visa, MasterCard, American Express and Discover, and our <a href="/wellness-plans/">PAWS wellness plans</a> let you pay for routine care monthly.</p>
      </div>
      <ul class="pay__grid">
        {options.map((o) => (
          <li class="pay__card">
            <div class="pay__logo">
              {o.logo ? <Image src={o.logo} alt={o.name} height={40} /> : <span class="pay__name">{o.name}</span>}
            </div>
            <p>{o.text}</p>
            <a class="pay__link" href={o.href} {...(o.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
              {o.cta} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section id="cherry" class="pay-cherry">
    <div class="pay__inner">
      <CherryWidget />
    </div>
  </section>
</ContentPage>

<style>
  .pay { padding-block: var(--space-section); }
  .pay__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-md); }
  .pay__intro { max-width: var(--container-max-narrow); margin: 0 auto var(--space-xl); text-align: center; }
  .pay__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--space-lg); }
  .pay__card { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-lg); background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
  .pay__card p { margin: 0; color: var(--text-muted); font-size: var(--font-size-sm); }
  .pay__logo { min-height: 2.75rem; display: flex; align-items: center; }
  .pay__logo :global(img) { width: auto; max-width: 100%; }
  .pay__name { font-family: var(--font-heading); font-weight: 700; font-size: var(--font-size-lg); color: var(--heading); }
  .pay__link { margin-block-start: auto; font-weight: 600; text-decoration: none; transition: color var(--motion-duration-base) var(--motion-ease); }
  .pay__link:hover { color: var(--cta); }
  .pay-cherry { padding-block: var(--space-section); background: var(--solid-bg); scroll-margin-top: var(--header-height); }
</style>
