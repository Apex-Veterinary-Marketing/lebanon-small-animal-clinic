---
// ServicesSidebar mounted 2026-09-17 (direct instruction: every
// services-related page always carries it). No active category here —
// this page browses everything.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeaderBanner from "../../components/PageHeaderBanner.astro";
import ServiceGrid from "../../components/ServiceGrid.astro";
import { getAllServices } from "../../lib/data/services";
import banner from "../../assets/services/rabbit.jpg";
import CtaBand from "../../components/CtaBand.astro";

const services = await getAllServices();
---

<BaseLayout title="Pet Care Services" description="Wellness exams, vaccines, diagnostics, dentistry, surgery, urgent care, house calls and more at Lebanon Small Animal Clinic in Lebanon, Ohio.">
  <PageHeaderBanner
    heading="Pet care for every stage of life"
    eyebrow="Pet care"
    intro="Wellness visits, diagnostics, dentistry, surgery and same-day urgent care, all under one roof in Lebanon."
    image={banner}
    imageAlt="A rabbit resting on a cushion"
  />
  <section class="services-index">
    <div class="services-index__inner">
      <ServiceGrid services={services} />
    </div>
  </section>
  <CtaBand heading="Not sure what your pet needs?" text="Give us a call and our team will help you choose the right visit." />
</BaseLayout>

<style>
  .services-index { padding-block: var(--space-section); background: var(--solid-bg); }
  .services-index__inner { max-width: var(--container-max); margin-inline: auto; padding-inline: var(--space-md); }
</style>
